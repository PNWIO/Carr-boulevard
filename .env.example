# Cloudflare Pages → Settings → Environment variables & secrets.
# Nothing here is required for the site to build or deploy; each one switches on a feature.

# Signs the data-room access cookie. Generate: openssl rand -hex 32
HMAC_SECRET=

# Cloudflare Turnstile (dash → Turnstile → add widget for homesoncarr.com)
TURNSTILE_SECRET_KEY=
PUBLIC_TURNSTILE_SITE_KEY=

# Lead notification email. Resend (resend.com) is the simplest; MailChannels also works.
RESEND_API_KEY=
LEAD_NOTIFY_TO=ian@laughlindevelopmentllc.com
LEAD_NOTIFY_FROM=notifications@homesoncarr.com
