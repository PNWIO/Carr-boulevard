---
import { project, seller, disclaimer, ehoStatement } from "~/data/project";
const year = new Date().getFullYear();
---

<footer class="ground-dark">
  <div class="shell">
    <div class="top">
      <div>
        <p class="eyebrow">Offered by</p>
        <p class="entity">{seller.entity}</p>
        <p class="descriptor">{seller.descriptor}</p>
      </div>

      <div class="contact">
        <p class="eyebrow">Enquiries — direct, no broker</p>
        <p class="name">{seller.contactName}</p>
        <p><a href={`mailto:${seller.email}?subject=${encodeURIComponent(project.name)}`}>{seller.email}</a></p>
        <p><a href={`tel:${seller.phoneHref}`}>{seller.phone}</a></p>
        <p class="mailing">{seller.mailing}</p>
      </div>

      <nav class="links" aria-label="Footer">
        <p class="eyebrow">This offering</p>
        <ul>
          <li><a href="/offering">Offering summary</a></li>
          <li><a href="/site-plan">Site plan and unit schedule</a></li>
          <li><a href="/location">Location and market</a></li>
          <li><a href="/data-room">Due-diligence data room</a></li>
          <li><a href="/inquire">Make an enquiry</a></li>
        </ul>
      </nav>
    </div>

    <hr class="rule" />

    <div class="legal">
      <p class="eho">
        <svg width="30" height="20" viewBox="0 0 60 40" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.6">
          <path d="M6 20 30 5l24 15" stroke-linejoin="round" />
          <path d="M12 21v14h36V21" stroke-linejoin="round" />
          <path d="M24 35V25h12v10" stroke-linejoin="round" />
        </svg>
        <span>{ehoStatement}</span>
      </p>
      <p class="disclaimer">{disclaimer}</p>
      <p class="copyright">
        © {year} {seller.entity}. {project.name}, {project.address}.
        <span>Civil engineering by N.L. Olson &amp; Associates, Inc., project {project.civilProjectNumber}.</span>
      </p>
    </div>
  </div>
</footer>

<style>
  footer { padding-block: clamp(3.5rem, 7vw, 6.5rem) 3rem; }
  .top {
    display: grid;
    gap: 2.75rem;
    grid-template-columns: 1.3fr 1fr 1fr;
    padding-bottom: 3.25rem;
  }
  @media (max-width: 900px) { .top { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 620px) { .top { grid-template-columns: 1fr; gap: 2.25rem; } }

  .entity {
    font-family: var(--font-display);
    font-variation-settings: "opsz" 60, "wght" 400;
    font-size: clamp(1.375rem, 2.4vw, 1.875rem);
    letter-spacing: -0.02em;
    margin: 0 0 0.4rem;
  }
  .descriptor, .mailing { color: var(--on-slate-muted); font-size: 0.875rem; margin: 0; }
  .name { margin: 0 0 0.25rem; font-weight: 500; }
  .contact p { margin: 0 0 0.3rem; font-size: 0.9375rem; }
  .contact a { text-decoration: none; border-bottom: 1px solid var(--rule-invert); }
  .contact a:hover { border-bottom-color: var(--brass); }
  .mailing { margin-top: 0.75rem; }

  .links ul { list-style: none; margin: 0; padding: 0; }
  .links li { margin-bottom: 0.45rem; }
  .links a { font-size: 0.9375rem; text-decoration: none; color: var(--on-slate-muted); }
  .links a:hover { color: var(--on-slate); }

  .legal { padding-top: 2.25rem; }
  .eho {
    display: flex;
    gap: 0.85rem;
    align-items: flex-start;
    color: var(--on-slate-muted);
    font-size: 0.75rem;
    line-height: 1.55;
    max-width: 62rem;
    margin: 0 0 1.5rem;
  }
  .eho svg { flex: none; margin-top: 0.15rem; color: var(--on-slate); }
  .disclaimer {
    color: var(--on-slate-muted);
    font-size: 0.6875rem;
    line-height: 1.65;
    max-width: 74rem;
    margin: 0 0 1.75rem;
  }
  .copyright { font-size: 0.75rem; color: var(--on-slate-muted); margin: 0; }
  .copyright span { display: block; }
</style>
