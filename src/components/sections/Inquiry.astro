---
import { seller, project, offering } from "~/data/project";
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---

<section id="inquire" class="section inquiry" aria-labelledby="inq-h">
  <div class="shell grid">
    <div class="intro">
      <p class="eyebrow">Enquiries</p>
      <h2 id="inq-h" class="display-l">Straight to the principal.</h2>
      <p class="lede measure-tight">
        No brokerage sits between you and this deal. {seller.contactName} owns the property,
        filed the application and answers the phone.
      </p>

      <dl class="direct">
        <div>
          <dt>Email</dt>
          <dd><a href={`mailto:${seller.email}?subject=${encodeURIComponent(project.name)}`}>{seller.email}</a></dd>
        </div>
        <div>
          <dt>Telephone</dt>
          <dd><a href={`tel:${seller.phoneHref}`}>{seller.phone}</a></dd>
        </div>
        <div>
          <dt>Pricing</dt>
          <dd>{offering.price} · {offering.closingCondition.toLowerCase()}</dd>
        </div>
      </dl>
    </div>

    <form class="form" data-inquiry method="post" action="/api/inquiry" novalidate>
      <div class="fields">
        <label class="span2">
          <span>Name</span>
          <input name="name" type="text" autocomplete="name" required />
        </label>
        <label>
          <span>Company</span>
          <input name="company" type="text" autocomplete="organization" required />
        </label>
        <label>
          <span>Buyer type</span>
          <select name="buyerType" required>
            <option value="">Select…</option>
            <option>Builder</option>
            <option>Developer</option>
            <option>Investor</option>
            <option>Broker</option>
            <option>Other</option>
          </select>
        </label>
        <label>
          <span>Email</span>
          <input name="email" type="email" autocomplete="email" required />
        </label>
        <label>
          <span>Phone</span>
          <input name="phone" type="tel" autocomplete="tel" />
        </label>
        <label class="span2">
          <span>Message</span>
          <textarea name="message" rows="4" placeholder="What would you like to know?"></textarea>
        </label>
      </div>
      {siteKey ? <div class="cf-turnstile" data-sitekey={siteKey}></div> : null}
      <button type="submit" class="submit">Send enquiry</button>
      <p class="msg" data-inquiry-msg role="status" aria-live="polite"></p>
    </form>
  </div>
</section>

<script is:inline>
  (() => {
    const form = document.querySelector("[data-inquiry]");
    if (!form) return;
    const msg = form.querySelector("[data-inquiry-msg]");
    const btn = form.querySelector(".submit");
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (!form.reportValidity()) return;
      btn.disabled = true;
      msg.dataset.state = "";
      msg.textContent = "Sending…";
      try {
        const res = await fetch(form.action, {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify(Object.fromEntries(new FormData(form))),
        });
        const data = await res.json().catch(() => ({}));
        if (res.ok) {
          form.querySelector(".fields").hidden = true;
          btn.hidden = true;
          msg.dataset.state = "ok";
          msg.textContent = "Received. Ian will come back to you directly, usually the same day.";
        } else {
          msg.dataset.state = "err";
          msg.textContent = data.message || "That didn't send. Email ian@laughlindevelopmentllc.com and it'll reach him.";
        }
      } catch {
        msg.dataset.state = "err";
        msg.textContent = "That didn't send. Email ian@laughlindevelopmentllc.com and it'll reach him.";
      } finally {
        btn.disabled = false;
      }
    });
  })();
</script>

<style>
  .grid {
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2.5rem, 6vw, 6rem); align-items: start;
  }
  @media (max-width: 900px) { .grid { grid-template-columns: 1fr; } }
  h2 { max-width: 12ch; margin-bottom: 1.5rem; }
  .lede { color: var(--muted); margin: 0 0 2.5rem; }

  .direct { margin: 0; border-top: 1px solid var(--rule); }
  .direct > div {
    display: flex; justify-content: space-between; gap: 1.5rem;
    padding: 0.9rem 0; border-bottom: 1px solid var(--rule);
  }
  .direct dt {
    font-size: 0.6875rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted);
  }
  .direct dd { margin: 0; font-size: 0.9375rem; text-align: right; }
  .direct a { text-decoration: none; border-bottom: 1px solid var(--rule); }
  .direct a:hover { border-bottom-color: var(--brass); }

  .form { background: var(--paper-2); border: 1px solid var(--rule); padding: clamp(1.5rem, 3vw, 2.25rem); }
  .fields { display: grid; grid-template-columns: 1fr 1fr; gap: 1.1rem; }
  .span2 { grid-column: 1 / -1; }
  @media (max-width: 520px) { .fields { grid-template-columns: 1fr; } }
  label > span {
    display: block; font-size: 0.6875rem; letter-spacing: 0.1em;
    text-transform: uppercase; color: var(--muted); margin-bottom: 0.4rem;
  }
  input, select, textarea {
    width: 100%; font: inherit; font-size: 0.9375rem;
    background: transparent; color: var(--ink);
    border: 0; border-bottom: 1px solid var(--rule);
    padding: 0.5rem 0; border-radius: 0;
  }
  textarea { resize: vertical; }
  select { cursor: pointer; }
  input:focus, select:focus, textarea:focus { outline: none; border-bottom-color: var(--brass-ink); }
  input:focus-visible, select:focus-visible, textarea:focus-visible { outline: 2px solid var(--brass-ink); outline-offset: 3px; }

  .submit {
    font: inherit; font-size: 0.75rem; letter-spacing: 0.13em; text-transform: uppercase;
    background: var(--ink); color: var(--paper); border: 0;
    padding: 1rem 1.75rem; cursor: pointer; margin-top: 1.75rem;
    transition: background 200ms;
  }
  .submit:hover:not(:disabled) { background: var(--brass-ink); }
  .submit:disabled { opacity: 0.5; cursor: progress; }
  .msg { font-size: 0.875rem; line-height: 1.55; margin: 1rem 0 0; }
  .msg[data-state="ok"] { color: var(--brass-ink); }
  .msg[data-state="err"] { color: #a33a2c; }
</style>
