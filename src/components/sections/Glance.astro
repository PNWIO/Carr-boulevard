---
import { glance } from "~/data/project";
---

<section id="glance" class="glance ground-dark" aria-labelledby="glance-h">
  <div class="shell">
    <h2 id="glance-h" class="sr">The offering at a glance</h2>
    <dl>
      {glance.map((g, i) => (
        <div class="cell" data-reveal style={`--reveal-delay:${Math.min(i, 4) * 55}ms`}>
          <dt class="data-figure">
            {g.figure}{"unit" in g && g.unit ? <span class="unit"> {g.unit}</span> : null}
          </dt>
          <dd>{g.label}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .glance { padding-block: clamp(3rem, 6vw, 5.5rem); }
  .sr {
    position: absolute; width: 1px; height: 1px; overflow: hidden;
    clip-path: inset(50%); white-space: nowrap;
  }
  dl {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1px;
    background: var(--rule-invert);
    border: 1px solid var(--rule-invert);
    margin: 0;
  }
  .cell {
    background: var(--slate);
    padding: 1.6rem 1.5rem 1.75rem;
    display: flex; flex-direction: column; gap: 0.55rem;
  }
  dt {
    font-size: clamp(1.75rem, 3.4vw, 2.875rem);
    font-weight: 400;
    letter-spacing: -0.035em;
    line-height: 1;
    color: var(--on-slate);
  }
  .unit { font-size: 0.42em; letter-spacing: 0.02em; color: var(--on-slate-muted); margin-left: 0.1em; }
  dd {
    margin: 0;
    font-size: 0.8125rem;
    line-height: 1.45;
    color: var(--on-slate-muted);
    text-wrap: pretty;
  }
  @media (max-width: 1080px) { dl { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 520px) {
    .cell { padding: 1.25rem 1.1rem 1.4rem; }
    dd { font-size: 0.75rem; }
  }
</style>
