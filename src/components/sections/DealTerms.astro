---
import { offering, site } from "~/data/project";

const terms = [
  ["Asking", offering.price],
  ["Closing", offering.closingCondition],
  ["Seller carries", "Entitlement review through preliminary approval"],
  ["Buyer takes", "Construction permits and post-approval conditions"],
  ["Assignment", offering.assignment],
  ["Representation", "Owner direct · no brokerage"],
];
---

<section class="terms" aria-labelledby="terms-h">
  <div class="shell wrap">
    <div class="intro">
      <p class="eyebrow">Deal terms</p>
      <h2 id="terms-h" class="display-m">A defined path to close.</h2>
      <p>Full due diligence is available under NDA. The preliminary plat and site development permit remain under City review.</p>
    </div>
    <dl>
      {terms.map(([label, value]) => <div><dt>{label}</dt><dd>{value}</dd></div>)}
    </dl>
    <aside>
      <p class="flag">Early optionality</p>
      <h3>Six GC-frontage lots can stand apart.</h3>
      <p>Parcel 1 is {site.parcel1SF.toLocaleString("en-US")} SF along Kitsap Way. The seller will consider a separate disposition of its six-home program.</p>
      <a href="/offering">Review the offering structure →</a>
    </aside>
  </div>
</section>

<style>
  .terms { background: var(--paper-2); border-block: 1px solid var(--rule); }
  .wrap { display: grid; grid-template-columns: .8fr 1.2fr .85fr; gap: clamp(2rem, 5vw, 5rem); padding-block: clamp(3rem, 6vw, 5rem); align-items: start; }
  .intro h2 { max-width: 9ch; margin-bottom: 1rem; }
  .intro > p:last-child, aside p { color: var(--muted); line-height: 1.6; font-size: .875rem; }
  dl { margin: 0; border-top: 1px solid var(--rule); }
  dl > div { display: grid; grid-template-columns: 7.5rem 1fr; gap: 1rem; padding: .8rem 0; border-bottom: 1px solid var(--rule); }
  dt, .flag { font-size: .65rem; letter-spacing: .13em; text-transform: uppercase; color: var(--muted); }
  dd { margin: 0; font-size: .9rem; line-height: 1.5; }
  aside { border-left: 2px solid var(--brass); padding-left: 1.4rem; }
  aside h3 { font-family: var(--font-display); font-size: 1.5rem; font-weight: 400; margin: .7rem 0; }
  aside a { font-size: .75rem; text-transform: uppercase; letter-spacing: .09em; color: var(--brass-ink); }
  @media (max-width: 980px) { .wrap { grid-template-columns: 1fr 1fr; } aside { grid-column: 1 / -1; } }
  @media (max-width: 650px) { .wrap { grid-template-columns: 1fr; } aside { grid-column: auto; } }
</style>
