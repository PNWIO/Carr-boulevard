---
import { planTypes, program } from "~/data/project";

const lotLabel = (parcel: number, lot: number) =>
  parcel === 1 ? `Parcel 1 · Lot ${lot}` : `Parcels 2–4 · Lot ${lot}`;
---

<section id="unit-schedule" class="section-tight matrix" aria-labelledby="matrix-h">
  <div class="shell">
    <div class="head">
      <div>
        <p class="eyebrow">Unit schedule</p>
        <h2 id="matrix-h" class="display-l">Six types. {program.totalUnits} homes.</h2>
      </div>
      <p class="note">
        The schedule is grouped by unit type. Use the lot menu in each row to find every location
        where that home is planned.
      </p>
    </div>

    <div class="scroll-x table-wrap">
      <table>
        <caption class="sr">
          Six unit types for the Carr Boulevard preliminary plat, with a dropdown listing the lots
          assigned to each type.
        </caption>
        <thead>
          <tr>
            <th scope="col">Type</th>
            <th scope="col">Footprint</th>
            <th scope="col" class="num">Homes</th>
            <th scope="col">Bedrooms / baths</th>
            <th scope="col">Garage</th>
            <th scope="col">Lot locations</th>
          </tr>
        </thead>
        <tbody>
          {planTypes.map((p) => (
            <tr>
              <th scope="row"><span class="type">Type {p.id}</span></th>
              <td data-label="Footprint">{p.footprint}</td>
              <td data-label="Homes" class="num">{p.units}</td>
              <td data-label="Bedrooms / baths">{p.beds} bed{"note" in p && p.note ? ` ${p.note}` : ""} · {p.baths} bath</td>
              <td data-label="Garage" class="garage">{p.garage}</td>
              <td data-label="Lot locations">
                <label class="lot-picker">
                  <span class="sr">Locate a Type {p.id} lot</span>
                  <select aria-label={`Locate a Type ${p.id} lot`}>
                    <option value="">Choose from {p.units} lots…</option>
                    {p.lots.map(({ parcel, lot }) => (
                      <option value={`${parcel}-${lot}`}>{lotLabel(parcel, lot)}</option>
                    ))}
                  </select>
                </label>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <p class="foot">
      Footprint dimensions are building footprints from the preliminary set, not finished area.
      Floor plans and finished areas are available in the <a href="/data-room">data room</a>.
    </p>
  </div>
</section>

<style>
  .head {
    display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 4rem); align-items: end; margin-bottom: 2.25rem;
  }
  @media (max-width: 860px) { .head { grid-template-columns: 1fr; align-items: start; } }
  .note { font-size: 0.8125rem; color: var(--muted); margin: 0; line-height: 1.6; max-width: 46ch; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

  .table-wrap { border: 1px solid var(--rule); }
  table { width: 100%; border-collapse: collapse; min-width: 54rem; font-size: 0.875rem; }
  thead th {
    background: var(--paper-2); border-bottom: 1px solid var(--rule);
    text-align: left; font-size: 0.6875rem; font-weight: 500;
    letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted);
    padding: 0.85rem 1rem;
  }
  tbody th { text-align: left; font-weight: 500; }
  tbody th, tbody td { padding: 0.85rem 1rem; border-bottom: 1px solid var(--rule); vertical-align: middle; }
  tbody tr:last-child th, tbody tr:last-child td { border-bottom: 0; }
  tbody tr:hover { background: color-mix(in srgb, var(--brass) 7%, transparent); }
  .type { color: var(--brass-ink); letter-spacing: 0.08em; text-transform: uppercase; white-space: nowrap; }
  .num { text-align: right; font-variant-numeric: tabular-nums; }
  .garage { color: var(--muted); }

  .lot-picker { display: block; min-width: 12.5rem; }
  select {
    width: 100%; min-height: 2.5rem; padding: 0.45rem 2.25rem 0.45rem 0.7rem;
    border: 1px solid var(--rule); border-radius: 0; background: var(--paper);
    color: var(--ink); font: inherit; font-size: 0.8125rem; cursor: pointer;
  }
  select:hover { border-color: var(--ink); }
  select:focus-visible { outline: 2px solid var(--brass-ink); outline-offset: 2px; }

  @media (max-width: 720px) {
    .table-wrap { border: 0; overflow: visible; }
    table, tbody, tr, th, td { display: block; min-width: 0; width: 100%; }
    thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
    tbody { display: grid; gap: 0.9rem; }
    tbody tr { border: 1px solid var(--rule); background: var(--paper); }
    tbody tr:hover { background: var(--paper); }
    tbody th {
      padding: 0.9rem 1rem; border-bottom: 1px solid var(--rule);
      background: var(--paper-2);
    }
    tbody td {
      display: grid; grid-template-columns: minmax(7.5rem, 0.75fr) minmax(0, 1.25fr);
      gap: 1rem; align-items: center; padding: 0.7rem 1rem;
    }
    tbody td::before {
      content: attr(data-label); font-size: 0.625rem; letter-spacing: 0.1em;
      text-transform: uppercase; color: var(--muted);
    }
    tbody td.num { text-align: left; }
    tbody tr:last-child th, tbody tr:last-child td { border-bottom: 1px solid var(--rule); }
    tbody tr td:last-child { border-bottom: 0; }
    .lot-picker { min-width: 0; }
  }

  .foot { margin: 1.25rem 0 0; font-size: 0.75rem; line-height: 1.6; color: var(--muted); max-width: 64ch; }
  .foot a { color: var(--brass-ink); text-underline-offset: 3px; }
</style>
