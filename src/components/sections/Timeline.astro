---
import { getCollection } from "astro:content";
const milestones = (await getCollection("milestones"))
  .map((m) => m.data)
  .sort((a, b) => a.sortKey.localeCompare(b.sortKey));
---

<section class="section timeline" aria-labelledby="tl-h">
  <div class="shell">
    <div class="head">
      <div>
        <p class="eyebrow">Entitlement</p>
        <h2 id="tl-h" class="display-l">Where the application stands.</h2>
      </div>
      <p class="note">
        The preliminary plat and site development permit are <strong>under review</strong> by the
        City of Bremerton. They are not approved. Closing is conditioned on approval, so the
        review sits with the seller rather than the buyer.
      </p>
    </div>

    <div class="scroll-x rail-wrap">
      <ol class="rail">
        {milestones.map((m, i) => (
          <li class="step" data-status={m.status} data-reveal style={`--reveal-delay:${Math.min(i, 5) * 60}ms`}>
            <div class="marker" aria-hidden="true"><span></span></div>
            <p class="date">{m.date}</p>
            <h3 class="title">{m.title}</h3>
            <p class="status"><span class="pill" data-status={m.status}>{m.status}</span></p>
            <p class="body">{m.body}</p>
            <p class="authority">
              {m.authority}{m.reference ? <><br />{m.reference}</> : null}
            </p>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .head {
    display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 4rem); align-items: end; margin-bottom: 3.25rem;
  }
  @media (max-width: 860px) { .head { grid-template-columns: 1fr; align-items: start; } }
  h2 { max-width: 14ch; }
  .head .note {
    font-size: 0.875rem; color: var(--muted); margin: 0; line-height: 1.65; max-width: 46ch;
  }
  .head .note strong { color: var(--ink); font-weight: 500; }

  .rail-wrap { padding-bottom: 0.75rem; }
  .rail {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-auto-flow: column;
    grid-auto-columns: minmax(15.5rem, 1fr);
    gap: 1px;
    background: var(--rule);
    border-top: 1px solid var(--rule);
    min-width: 60rem;
  }
  .step {
    background: var(--paper);
    padding: 2rem 1.5rem 1.75rem 0;
    padding-right: 1.75rem;
    position: relative;
  }
  .step + .step { padding-left: 1.75rem; }
  .marker { position: absolute; top: -5px; left: 0; }
  .step + .step .marker { left: 1.75rem; }
  .marker span {
    display: block; width: 9px; height: 9px; border-radius: 50%;
    background: var(--rule); outline: 4px solid var(--paper);
  }
  .step[data-status="Complete"] .marker span { background: var(--brass); }
  .step[data-status="In review"] .marker span { background: var(--ink); }

  .date {
    font-size: 0.6875rem; letter-spacing: 0.13em; text-transform: uppercase;
    color: var(--muted); margin: 0 0 0.85rem;
  }
  .title {
    font-family: var(--font-display);
    font-variation-settings: "opsz" 48, "wght" 400;
    font-size: 1.1875rem; letter-spacing: -0.02em; line-height: 1.2;
    margin: 0 0 0.75rem;
  }
  .status { margin: 0 0 0.9rem; }
  .pill {
    display: inline-block; font-size: 0.625rem; letter-spacing: 0.1em;
    text-transform: uppercase; padding: 0.3rem 0.55rem;
    border: 1px solid var(--rule); color: var(--muted);
  }
  .pill[data-status="Complete"] { border-color: color-mix(in srgb, var(--brass) 55%, transparent); color: var(--brass-ink); }
  .pill[data-status="In review"] { background: var(--ink); border-color: var(--ink); color: var(--paper); }

  .body { font-size: 0.8125rem; line-height: 1.6; color: var(--muted); margin: 0 0 1rem; }
  .authority { font-size: 0.6875rem; line-height: 1.5; color: var(--muted); margin: 0; opacity: 0.85; }

  @media (max-width: 860px) {
    .rail { min-width: 52rem; grid-auto-columns: minmax(13.5rem, 1fr); }
  }
</style>
