---
import "~/styles/global.css";
import Header from "~/components/layout/Header.astro";
import Footer from "~/components/layout/Footer.astro";
import { project, seller, program } from "~/data/project";

interface Props {
  title: string;
  description: string;
  /** Path for canonical + OG, e.g. "/offering" */
  path: string;
  /** Suppress the site header background until scroll (home only) */
  transparentHeader?: boolean;
}

const { title, description, path, transparentHeader = false } = Astro.props;
const canonical = new URL(path, Astro.site).href;
const ogImage = new URL(`/og${path === "/" ? "/index" : path}.png`, Astro.site).href;

const realEstateLd = {
  "@context": "https://schema.org",
  "@type": "RealEstateListing",
  name: project.name,
  url: canonical,
  description,
  datePosted: "2026-09-06",
  about: {
    "@type": "Residence",
    name: project.name,
    address: {
      "@type": "PostalAddress",
      streetAddress: "1746 Carr Blvd",
      addressLocality: project.city,
      addressRegion: "WA",
      postalCode: "98312",
      addressCountry: "US",
    },
    numberOfAccommodationUnits: program.totalUnits,
  },
  offers: {
    "@type": "Offer",
    availability: "https://schema.org/InStock",
    priceSpecification: {
      "@type": "PriceSpecification",
      description: "Price on request",
    },
  },
};

const orgLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: seller.entity,
  url: seller.website,
  email: seller.email,
  telephone: seller.phone,
  areaServed: "Kitsap County, Washington",
  description: seller.descriptor,
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <link rel="preload" href="/fonts/fraunces-var.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-var.woff2" as="font" type="font/woff2" crossorigin />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#1e3448" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0c161f" media="(prefers-color-scheme: dark)" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={project.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="robots" content="index, follow" />
    <meta name="geo.region" content="US-WA" />
    <meta name="geo.placename" content={`${project.city}, ${project.state}`} />

    <script type="application/ld+json" set:html={JSON.stringify(realEstateLd)} is:inline />
    <script type="application/ld+json" set:html={JSON.stringify(orgLd)} is:inline />
  </head>
  <body>
    <a
      href="#main"
      style="position:absolute;left:-9999px;top:0;z-index:100;background:var(--slate);color:var(--on-slate);padding:.75rem 1.25rem"
      onfocus="this.style.left='0'"
      onblur="this.style.left='-9999px'">Skip to content</a
    >
    <Header transparent={transparentHeader} />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      // Scroll reveal + header state. ~1 KB, no dependencies, motion-gated.
      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
      const targets = document.querySelectorAll<HTMLElement>("[data-reveal]");
      if (reduce.matches || !("IntersectionObserver" in window)) {
        targets.forEach((el) => el.classList.add("is-in"));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add("is-in");
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: "0px 0px -8% 0px", threshold: 0.08 },
        );
        targets.forEach((el) => io.observe(el));
      }

      const header = document.querySelector<HTMLElement>("[data-header]");
      if (header) {
        const sentinel = document.createElement("div");
        sentinel.setAttribute("aria-hidden", "true");
        sentinel.style.cssText = "position:absolute;top:0;height:1px;width:1px";
        header.insertAdjacentElement("beforebegin", sentinel);
        new IntersectionObserver(([e]) => header.classList.toggle("is-stuck", !e!.isIntersecting)).observe(sentinel);
      }
    </script>
  </body>
</html>
